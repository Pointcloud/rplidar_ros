# RVIZ Configuration for lidar_test_launch.py
# Fixed Frame: map
# Displays: Grid, TF, LaserScan on /scan topic
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /LaserScan1
    Tree Height: 300
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1.0
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Plane: XY
      Plane Cell Count: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Arrows: true
      Show Axes: true
      Marker Scale: 1.0
      Frame Timeout: 15.0
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
      Alpha: 1.0
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Color Transformer: Intensity
      Decay Time: 0.0
      Flat Color: 255; 0; 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096.0
      Min Color: 0; 0; 0
      Min Intensity: 0.0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Flat Squares
      Use Fixed Frame: true
      Use Rainbow: true
  Enabled: true
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Yaw: 0.0
      Pitch: 0.785
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
Window Geometry:
  Height: 720
  Width: 1280
  X: 100
  Y: 100
  QMainWindow State: ""
